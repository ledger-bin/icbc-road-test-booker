# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored -- it never gets committed. In the cloud (Render,
# Railway, Fly, etc.), don't upload this file at all -- set these same
# variable names in your platform's environment variable settings instead.

# --- ICBC login ---
DRIVERS_LAST_NAME=
LICENCE_NUMBER=
KEYWORD=

# --- Verification (code auto-read via IMAP) ---
VERIFICATION_METHOD=email
VERIFICATION_EMAIL_ADDRESS=
# A Gmail "app password" (requires 2FA): https://myaccount.google.com/apppasswords
VERIFICATION_EMAIL_APP_PASSWORD=
VERIFICATION_TIMEOUT_SECONDS=120

# --- Telegram bot ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated chat id(s) allowed to control the bot and receive
# updates, e.g. TELEGRAM_AUTHORIZED_CHAT_IDS=815893142
TELEGRAM_AUTHORIZED_CHAT_IDS=

# --- Optional ---
# DEBUG=False
# PERIODIC_DELAY=570
# PERIODIC_DELAY_JITTER_SECONDS=150
# SEND_EMAIL_NOTIF=False
# EMAIL_SENDER_ACCOUNT=
# EMAIL_SENDER_PASSWORD=
# EMAIL_RECIPIENTS=
